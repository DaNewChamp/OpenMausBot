{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-bridge",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "bridge/src/**/*",
    "shared/bridge-hermes-contract.ts",
    "shared/fleet-presentation.ts",
    "shared/hermes-signin-launch.ts",
    "server/contracts.ts",
    "server/atomic.ts",
    "server/data-dir.ts",
    "server/engines/contracts.ts",
    "server/engines/discovery.ts",
    "server/engines/bindings.ts",
    "server/engines/hermes.ts"
  ],
  "exclude": [
    "bridge/src/**/*.test.ts",
    "bridge/src/index-helpers.ts"
  ]
}
