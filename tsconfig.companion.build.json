{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-companion",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "companion/src/**/*",
    "shared/fleet-presentation.ts",
    "server/pairing-invitations.ts",
    "server/atomic.ts"
  ],
  "exclude": [
    "companion/src/**/*.test.ts"
  ]
}
